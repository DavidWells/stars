{
  "name": "github-stars",
  "version": "1.0.0",
  "description": "Collect your starred repos and generate a README",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --env-file .env src/run.js",
    "build": "node src/run.js",
    "deploy": "node scripts/deploy.js",
    "gen": "node scripts/readme.js",
    "site:data": "node scripts/site-data.js DavidWells",
    "site:dev": "vite --config vite.config.js",
    "site:local": "pnpm site:data && vite --config vite.config.js --host 127.0.0.1",
    "site:build": "vite build --config vite.config.js",
    "site:preview": "vite preview --config vite.config.js",
    "serve": "serve .site-build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fs-extra": "^11.2.0",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "markdown-magic": "^3.4.0",
    "ofetch": "^1.4.1",
    "p-limit": "^6.2.0",
    "react": "^19",
    "react-dom": "^19",
    "safe-await": "^2.0.0"
  },
  "packageManager": "pnpm@9.15.3",
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@vitejs/plugin-react": "^6.0.3",
    "serve": "^14.2.4",
    "vite": "^8.1.3"
  }
}
